# ─────────────────────────────────────────────────────────────
# Backend (backend/) — copy to backend/.env for local development
# Vercel injects these automatically in production.
# ─────────────────────────────────────────────────────────────

# Database (libSQL / Turso). Omit to use the local file fallback.
TURSO_DATABASE_URL=file:./data.db
TURSO_AUTH_TOKEN=

# Auth — ALWAYS set a strong value in production
JWT_SECRET=

# Public URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
# Public origin of the API itself (used for the Telegram webhook URL)
BACKEND_URL=http://localhost:3001
# Comma-separated extra CORS origins
ALLOWED_ORIGINS=

# Seed admin
ADMIN_EMAIL=admin@lms.com
ADMIN_PASSWORD=admin123

# Email (SMTP) notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="وحدة التدريب و التطوير" <no-reply@example.com>

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional — derived from the bot token when omitted
TELEGRAM_WEBHOOK_SECRET=

# Scheduled jobs
CRON_SECRET=

# AI assistant (optional)
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Frontends (admin-ui/ and user-ui/) — use .env.local
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:3001
